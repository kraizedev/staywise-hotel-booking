# Neon: pooled connection string (host contains -pooler) for the app
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Neon: direct (non-pooled) connection string for migrations
DIRECT_URL="postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Admin session signing secret (run: openssl rand -base64 32)
AUTH_SECRET="change-me"
# Used by the seed script to create the first admin
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-now"

# Cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

HOTEL_NAME="Your Hotel"
CURRENCY="USD"
